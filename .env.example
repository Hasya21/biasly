# Clerk: set real development keys only in ignored .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase persistence: all application database access is server-side.
# The anon key is reserved for compatibility; it has no access to internal tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only manual scraping credentials and action-route authorization.
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=
BIASLY_ADMIN_SECRET=
# Server-only AI analysis (gpt-5.4-mini); batch size must be 1-100.
OPENAI_API_KEY=
ANALYSIS_BATCH_SIZE=5

# Production only: create this secret in Vercel; Vercel sends it as Authorization: Bearer.
# Never copy this into .env.local. Hourly Cron requires Vercel Pro or Enterprise.
CRON_SECRET=

# PostHog browser analytics (set real values in .env.local or the deployment environment).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host
